# =====================================================================
# Suno Architect Suite — Environment Variables
# =====================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in the values below as needed.
# 3. Restart backend after editing.
# =====================================================================

# ---------------------------------------------------------------------
# [REQUIRED] Gemini API Key
# Used for: Prompt generation, lyrics generation, image-to-prompt, etc.
# Without this key, all AI generation features will be unavailable.
# Get your key at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ---------------------------------------------------------------------
# [OPTIONAL] Google Custom Search — Search Engine Grounding
# Used for: Fetching latest music trend info to enrich prompts.
# Both CSE Key AND CX (Search Engine ID) are required to enable this.
# Without these, search-grounded prompt generation is skipped.
# Setup guide: https://developers.google.com/custom-search/v1/introduction
# ---------------------------------------------------------------------
GOOGLE_CUSTOM_SEARCH_API_KEY=your_google_cse_key
GOOGLE_CUSTOM_SEARCH_CX=your_search_engine_id

# ---------------------------------------------------------------------
# [OPTIONAL] Tavily AI Search — Alternative Search Provider
# Used for: Web search-grounded prompt generation (alternative to Google CSE).
# If both Tavily and Google CSE are set, Google CSE takes priority.
# Get your key at: https://app.tavily.com/
# ---------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_key

# ---------------------------------------------------------------------
# [OPTIONAL] FireCrawl — Web Content Scraping
# Used for: Deeper web content extraction during search grounding.
# If FIRECRAWL_API_URL is not set, FireCrawl integration is skipped.
# Run locally with: docker run -p 3002:3002 mendableai/firecrawl
# ---------------------------------------------------------------------
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key
