                                            )}
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div className="space-y-4">
                                <div>
                                    <label className="text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2 block pl-1">Song Description / 楽曲スタイル (Prompt)</label>
                                    <textarea
