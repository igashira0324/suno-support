                                            >
                                                <div className={`absolute top-0.5 w-3 h-3 rounded-full bg-white transition-all duration-300 ${state.autoTrim ? 'left-4.5' : 'left-0.5'}`} style={{ left: state.autoTrim ? '18px' : '2px' }} />
                                            </div>
                                        </div>
                                    </div>
                                )}

                                {/* Cover Mode Controls */}
                                {/* Cover Mode Controls */}
                                {state.task_type === 'cover' && (
