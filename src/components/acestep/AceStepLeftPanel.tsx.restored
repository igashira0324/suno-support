                                        {/* Cover LM A/B Toggle */}
                                        <div className="space-y-2">
                                            <div className="flex items-center justify-between">
                                                <label className="text-[10px] font-black uppercase tracking-widest text-slate-500">
                                                    Cover LM A/B Toggle
                                                </label>
                                                <span className={`text-[10px] font-mono font-bold ${state.coverRepaintUseLm ? 'text-emerald-400' : 'text-amber-400'}`}>
                                                    {state.coverRepaintUseLm ? 'LM: ON (B)' : 'LM: OFF (A)'}
                                                </span>
                                            </div>
                                            <div className="grid grid-cols-2 gap-2">
                                                <button
                                                    onClick={() => setState(prev => ({ ...prev, coverRepaintUseLm: false }))}
