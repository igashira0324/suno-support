                                                state.isAnalyzing ? 'bg-indigo-600/50 text-indigo-200 cursor-wait' :
                                                    'bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-500/20'
                                                }`}
                                        >
                                            {state.isAnalyzing ? (
                                                <>
                                                    <Loader2 className="w-3.5 h-3.5 animate-spin" />
                                                    Analyzing...
                                                </>
                                            ) : (
