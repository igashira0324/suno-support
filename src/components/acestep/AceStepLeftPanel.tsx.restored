                                                    title={isTurboModel(state.model) ? 'TurboではLM ONを使えません' : ''}
                                                    className={`py-2 rounded-lg text-[10px] font-bold uppercase tracking-wider border transition-all ${state.coverRepaintUseLm
                                                        ? 'bg-emerald-500/20 border-emerald-400/60 text-emerald-300'
                                                        : 'bg-slate-800/50 border-white/10 text-slate-400 hover:text-slate-200'} ${isTurboModel(state.model) ? 'opacity-50 cursor-not-allowed' : ''}`}
                                                >
                                                    B: LM ON
                                                </button>
                                            </div>
                                            <p className="text-[9px] text-slate-500">
                                                Cover専用の比較スイッチです。A/Bで同条件生成して聴き比べてください。
                                            </p>
                                        </div>

                                        {/* Source Type Selector */}
                                        <div className="flex bg-slate-800/50 p-1 rounded-lg">
                                            <button
