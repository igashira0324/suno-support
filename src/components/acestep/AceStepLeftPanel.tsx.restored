        handleConvertAndMerge, handleExtractLyrics, handleModelChange, 
        handleTaskTypeChange, handleCoverAudioUpload, handleCoverAudioDrop, 
        clearCoverAudio, handleReferenceAudioUpload, handleReferenceAudioDrop, 
